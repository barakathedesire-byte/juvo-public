APP_NAME=Juvo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_ADMIN_DOMAIN=
APP_VENDOR_DOMAIN=
ASSET_URL=

# Public demo login. Do not enable this on a real deployment.
DEMO_MODE=true
DEMO_LOGIN=admin
DEMO_EMAIL=admin@example.com
DEMO_PASSWORD=admin

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=juvo
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
# Keep session cookies HTTPS-only in production (defaults to true when APP_ENV=production).
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

APP_LOCALE=en
# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/customer/auth/google/callback"

# Juvo Logistics Integration
JUVO_LOGISTICS_ENABLED=false
JUVO_LOGISTICS_API_URL=http://localhost/api/v4
JUVO_LOGISTICS_API_KEY=
JUVO_LOGISTICS_API_SECRET=
JUVO_LOGISTICS_TIMEOUT=30
JUVO_LOGISTICS_RETRY_ATTEMPTS=3
JUVO_LOGISTICS_RETRY_DELAY=1000

JUVO_LOGISTICS_WEBHOOK_SECRET=
JUVO_LOGISTICS_WEBHOOK_IPS=

JUVO_LOGISTICS_DEFAULT_CARRIER=juvo-fleet
JUVO_LOGISTICS_AUTO_DISPATCH=true
JUVO_LOGISTICS_REQUIRE_CONFIRMATION=false

JUVO_LOGISTICS_TRACKING_URL=http://localhost/track
JUVO_LOGISTICS_EMBED_TRACKING=true

JUVO_LOGISTICS_FLEET_MIN_DRIVER_RATING=4.0
JUVO_LOGISTICS_FLEET_MAX_DISTANCE_KM=50
JUVO_LOGISTICS_FLEET_COD_ENABLED=true
JUVO_LOGISTICS_FLEET_POD_REQUIRED=true
JUVO_LOGISTICS_FLEET_PHOTO_REQUIRED=true
JUVO_LOGISTICS_FLEET_SIGNATURE_REQUIRED=false
